NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical site URL for metadata, robots.txt and sitemap. Defaults to https://yeahbuddy.fit.
# NEXT_PUBLIC_SITE_URL=

# Express API origin. /backend/* is proxied here; server components call it directly.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional: a private origin for server-side calls (overrides NEXT_PUBLIC_API_URL there).
# API_URL_INTERNAL=

# Supabase Auth in the browser. Either Supabase Cloud or the self-hosted stack
# (see docs/supabase-switch.md) — must be the same Supabase the backend uses:
#   Cloud:       https://[YOUR_PROJECT_REF].supabase.co + the project's anon/publishable key
#   Self-hosted: https://supabase.hominhduc.cloud + ANON_KEY from ~/supabase/.env on the VPS
# Never put a service-role key here: NEXT_PUBLIC_* values ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
# Older name, read only when NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is empty.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile — leave empty to disable CAPTCHA on auth forms.
# Create a widget at https://dash.cloudflare.com → Turnstile → Add widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: Google Analytics 4 measurement id (G-XXXXXXX). Empty disables analytics.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional: show TanStack Query devtools.
# NEXT_PUBLIC_ENABLE_QUERY_DEVTOOLS=true
