digraph UML {
graph [rankdir=LR, bgcolor="#f8faff", pad="0.35", nodesep="0.55", ranksep="1.0", splines=ortho, fontname="Arial"];
node [shape=plain, fontname="Arial"];
edge [color="#7a8fab", penwidth=1.2, arrowsize=0.7, fontname="Arial", fontsize=9, fontcolor="#526680"];
subgraph cluster_presentation { label="Presentation"; color="#c5d6f4"; style="rounded"; fontname="Arial"; fontcolor="#36548c"; NextAppRouter [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#263f68"><FONT COLOR="white"><B>NextAppRouter</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>attributes</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- route: AppRouter</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- session: ServerSession</TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>methods</B></TD></TR><TR><TD ALIGN="LEFT">+ renderShell()</TD></TR><TR><TD ALIGN="LEFT">+ proxyBackendRequest()</TD></TR><TR><TD ALIGN="LEFT">+ enforceAuthRedirect()</TD></TR></TABLE>>]; BackendRoutes [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#263f68"><FONT COLOR="white"><B>BackendRoutes</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>attributes</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- request: ExpressRequest</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- response: ExpressResponse</TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>methods</B></TD></TR><TR><TD ALIGN="LEFT">+ registerRoutes()</TD></TR><TR><TD ALIGN="LEFT">+ sendData()</TD></TR><TR><TD ALIGN="LEFT">+ sendError()</TD></TR><TR><TD ALIGN="LEFT">+ sendApiError()</TD></TR></TABLE>>];}
subgraph cluster_application { label="Application services"; color="#c8e4d2"; style="rounded"; fontname="Arial"; fontcolor="#33734a"; AuthService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#263f68"><FONT COLOR="white"><B>AuthService</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>attributes</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- supabase: SupabaseClient</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- prisma: PrismaClient</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- profileCache: Map</TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>methods</B></TD></TR><TR><TD ALIGN="LEFT">+ registerUser()</TD></TR><TR><TD ALIGN="LEFT">+ loginUser()</TD></TR><TR><TD ALIGN="LEFT">+ refreshAuthSession()</TD></TR><TR><TD ALIGN="LEFT">+ requireCurrentProfile()</TD></TR><TR><TD ALIGN="LEFT">+ updateCurrentProfile()</TD></TR><TR><TD ALIGN="LEFT">+ uploadCurrentProfileAvatar()</TD></TR><TR><TD ALIGN="LEFT">+ logoutCurrentSession()</TD></TR></TABLE>>]; AIService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#263f68"><FONT COLOR="white"><B>AIService</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>attributes</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- prisma: PrismaClient</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- provider: AIProvider</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- rateLimiter: RateLimiter</TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>methods</B></TD></TR><TR><TD ALIGN="LEFT">+ generateWorkoutProgram()</TD></TR><TR><TD ALIGN="LEFT">+ acceptAIProgram()</TD></TR><TR><TD ALIGN="LEFT">+ generateMealPlan()</TD></TR><TR><TD ALIGN="LEFT">+ acceptAIMealPlan()</TD></TR><TR><TD ALIGN="LEFT">+ buildChatContext()</TD></TR><TR><TD ALIGN="LEFT">+ chatWithAI()</TD></TR></TABLE>>]; NutritionService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#263f68"><FONT COLOR="white"><B>NutritionService</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>attributes</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- prisma: PrismaClient</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- timezone: string</TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>methods</B></TD></TR><TR><TD ALIGN="LEFT">+ listNutritionDayForUser()</TD></TR><TR><TD ALIGN="LEFT">+ listFoodsForUser()</TD></TR><TR><TD ALIGN="LEFT">+ createFoodForUser()</TD></TR><TR><TD ALIGN="LEFT">+ addMealItemForUser()</TD></TR><TR><TD ALIGN="LEFT">+ recalculateMeal()</TD></TR><TR><TD ALIGN="LEFT">+ deleteMealItemForUser()</TD></TR></TABLE>>]; FitnessDataService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#263f68"><FONT COLOR="white"><B>FitnessDataService</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>attributes</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- prisma: PrismaClient</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- profile: SerializedProfile</TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>methods</B></TD></TR><TR><TD ALIGN="LEFT">+ getDashboard()</TD></TR><TR><TD ALIGN="LEFT">+ listWorkouts()</TD></TR><TR><TD ALIGN="LEFT">+ logWorkout()</TD></TR><TR><TD ALIGN="LEFT">+ getProgress()</TD></TR><TR><TD ALIGN="LEFT">+ listNotifications()</TD></TR></TABLE>>]; AdminService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#263f68"><FONT COLOR="white"><B>AdminService</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>attributes</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- prisma: PrismaClient</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- supabase: SupabaseClient</TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>methods</B></TD></TR><TR><TD ALIGN="LEFT">+ getAdminDashboard()</TD></TR><TR><TD ALIGN="LEFT">+ listAdminUsers()</TD></TR><TR><TD ALIGN="LEFT">+ updateAdminUser()</TD></TR><TR><TD ALIGN="LEFT">+ reviewExerciseImportRequest()</TD></TR><TR><TD ALIGN="LEFT">+ applyExerciseSync()</TD></TR><TR><TD ALIGN="LEFT">+ logAdminAudit()</TD></TR></TABLE>>];}
subgraph cluster_infrastructure { label="Infrastructure"; color="#f0d4aa"; style="rounded"; fontname="Arial"; fontcolor="#95611d"; AIProvider [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#263f68"><FONT COLOR="white"><B>«interface» AIProvider</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>attributes</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- model: string</TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>methods</B></TD></TR><TR><TD ALIGN="LEFT">+ generateStructuredJSON&lt;T&gt;()</TD></TR><TR><TD ALIGN="LEFT">+ generateText()</TD></TR></TABLE>>]; OpenAIProvider [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#263f68"><FONT COLOR="white"><B>OpenAIProvider</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>attributes</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- client: OpenAI</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- jsonMode: boolean</TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>methods</B></TD></TR><TR><TD ALIGN="LEFT">+ generateStructuredJSON&lt;T&gt;()</TD></TR><TR><TD ALIGN="LEFT">+ generateText()</TD></TR></TABLE>>]; AnthropicProvider [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#263f68"><FONT COLOR="white"><B>AnthropicProvider</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>attributes</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- client: Anthropic</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- model: string</TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>methods</B></TD></TR><TR><TD ALIGN="LEFT">+ generateStructuredJSON&lt;T&gt;()</TD></TR><TR><TD ALIGN="LEFT">+ generateText()</TD></TR></TABLE>>]; PrismaClient [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#263f68"><FONT COLOR="white"><B>PrismaClient</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>attributes</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- user: UserDelegate</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- program: ProgramDelegate</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- meal: MealDelegate</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- aiGeneration: AIGenerationDelegate</TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>methods</B></TD></TR><TR><TD ALIGN="LEFT">+ $transaction()</TD></TR><TR><TD ALIGN="LEFT">+ $connect()</TD></TR><TR><TD ALIGN="LEFT">+ $disconnect()</TD></TR></TABLE>>]; SupabaseClient [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#263f68"><FONT COLOR="white"><B>SupabaseClient</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>attributes</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- auth: AuthClient</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- storage: StorageClient</TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>methods</B></TD></TR><TR><TD ALIGN="LEFT">+ signInWithPassword()</TD></TR><TR><TD ALIGN="LEFT">+ signUp()</TD></TR><TR><TD ALIGN="LEFT">+ getUser()</TD></TR><TR><TD ALIGN="LEFT">+ refreshSession()</TD></TR><TR><TD ALIGN="LEFT">+ upload()</TD></TR></TABLE>>];}
subgraph cluster_domain { label="Domain objects"; color="#dbc9ee"; style="rounded"; fontname="Arial"; fontcolor="#69458d"; User [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#263f68"><FONT COLOR="white"><B>User</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>attributes</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- id: UUID</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- email: string</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- role: UserRole</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- coachId?: UUID</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- dailyCalorieGoal: number</TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>methods</B></TD></TR><TR><TD ALIGN="LEFT">+ ownsResource()</TD></TR><TR><TD ALIGN="LEFT">+ isCoach()</TD></TR><TR><TD ALIGN="LEFT">+ isAdmin()</TD></TR></TABLE>>]; Program [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#263f68"><FONT COLOR="white"><B>Program</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>attributes</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- id: UUID</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- name: string</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- difficulty: ProgramDifficulty</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- createdById: UUID</TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>methods</B></TD></TR><TR><TD ALIGN="LEFT">+ addWorkout()</TD></TR><TR><TD ALIGN="LEFT">+ assignToTrainee()</TD></TR><TR><TD ALIGN="LEFT">+ archive()</TD></TR></TABLE>>]; Workout [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#263f68"><FONT COLOR="white"><B>Workout</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>attributes</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- id: UUID</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- programId?: UUID</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- scheduledDate?: Date</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- weekIndex?: number</TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>methods</B></TD></TR><TR><TD ALIGN="LEFT">+ addExercise()</TD></TR><TR><TD ALIGN="LEFT">+ reschedule()</TD></TR><TR><TD ALIGN="LEFT">+ duplicate()</TD></TR></TABLE>>]; Meal [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#263f68"><FONT COLOR="white"><B>Meal</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>attributes</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- id: UUID</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- userId: UUID</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- date: Date</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- type: MealType</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- totalCalories: number</TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>methods</B></TD></TR><TR><TD ALIGN="LEFT">+ addFoodItem()</TD></TR><TR><TD ALIGN="LEFT">+ recalculateTotals()</TD></TR><TR><TD ALIGN="LEFT">+ removeFoodItem()</TD></TR></TABLE>>]; Food [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#263f68"><FONT COLOR="white"><B>Food</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>attributes</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- id: UUID</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- name: string</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- caloriesPer100g: number</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- proteinPer100g: number</TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>methods</B></TD></TR><TR><TD ALIGN="LEFT">+ calculateNutrition()</TD></TR><TR><TD ALIGN="LEFT">+ isOwnedBy()</TD></TR></TABLE>>]; AIGeneration [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#263f68"><FONT COLOR="white"><B>AIGeneration</B></FONT></TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>attributes</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- id: UUID</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- userId: UUID</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- type: AIGenerationType</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- status: AIGenerationStatus</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- input: Json</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#f6f8fc">- output?: Json</TD></TR><TR><TD BGCOLOR="#eaf0fb"><B>methods</B></TD></TR><TR><TD ALIGN="LEFT">+ markCompleted()</TD></TR><TR><TD ALIGN="LEFT">+ markFailed()</TD></TR><TR><TD ALIGN="LEFT">+ isAcceptable()</TD></TR></TABLE>>];}
NextAppRouter -> BackendRoutes [label="association"];
BackendRoutes -> AuthService [label="association"];
