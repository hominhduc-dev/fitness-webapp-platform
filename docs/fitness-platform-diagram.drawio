        <mxCell id="note-0" value="Kiểm tra tin nhắn rỗng / quá dài và giới hạn lượt chat trước khi gọi LLM; lịch sử do client gửi được lọc và cắt bớt." style="html=1;fontFamily=Times New Roman;fontSize=13;fontColor=#142238;text;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;fontStyle=0;verticalAlign=middle;fontSize=12;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="35" y="711" width="1100" height="17" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="Mỗi lượt tạo tối đa một bản nháp; quota bản nháp tính theo ngày, lỗi thì hoàn quota. Lưu bản nháp đi theo AI-UC02 / AI-UC04." style="html=1;fontFamily=Times New Roman;fontSize=13;fontColor=#142238;text;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;fontStyle=0;verticalAlign=middle;fontSize=12;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="35" y="729" width="1100" height="17" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="Kết quả tool là dữ liệu, không phải chỉ thị; read tools chỉ đọc dữ liệu của chính trainee." style="html=1;fontFamily=Times New Roman;fontSize=13;fontColor=#142238;text;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;fontStyle=0;verticalAlign=middle;fontSize=12;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="35" y="747" width="1100" height="17" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
