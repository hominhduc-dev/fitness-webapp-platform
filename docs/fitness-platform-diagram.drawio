        <mxCell id="note-0" value="Chỉ coach; tối đa 20 lượt đọc ảnh mỗi ngày. Lượt lỗi hoặc không đọc được bài tập nào được hoàn quota." style="html=1;fontFamily=Times New Roman;fontSize=13;fontColor=#142238;text;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;fontStyle=0;verticalAlign=middle;fontSize=12;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="35" y="822" width="1100" height="17" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="Ghép tên: khớp chính xác trước, chỉ gửi LLM các dòng còn lại kèm ứng viên; dòng không có ứng viên để coach tự chọn. Thiếu số set dùng số set phổ biến nhất." style="html=1;fontFamily=Times New Roman;fontSize=13;fontColor=#142238;text;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;fontStyle=0;verticalAlign=middle;fontSize=12;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="35" y="840" width="1100" height="17" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="Bước đọc ảnh không ghi CSDL. Tạo giáo án dùng API tạo giáo án thông thường của coach (bước 11–13)." style="html=1;fontFamily=Times New Roman;fontSize=13;fontColor=#142238;text;fillColor=none;strokeColor=none;whiteSpace=wrap;align=left;fontStyle=0;verticalAlign=middle;fontSize=12;spacing=0;" vertex="1" parent="1">
