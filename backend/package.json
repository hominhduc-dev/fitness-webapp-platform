{
  "name": "fitness-app-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "create:admin": "tsx src/scripts/create-admin.ts",
    "classify:exercise-muscles": "tsx src/scripts/classify-exercise-muscles.ts",
    "apply:muscle-profile-report": "tsx src/scripts/apply-muscle-profile-report.ts",
    "audit:muscle-profiles": "tsx src/scripts/audit-muscle-profiles.ts",
    "backup:muscle-profile-rollout": "tsx src/scripts/backup-muscle-profile-rollout.ts",
    "backfill:workout-muscles": "tsx src/scripts/backfill-workout-muscle-snapshots.ts",
    "dev": "tsx watch src/index.ts",
    "prisma:resolve:baseline": "prisma migrate resolve --applied 20260319_initial_schema_baseline",
    "seed:exercises": "tsx src/scripts/seed-exercise-library.ts",
    "sync:exercise-dataset": "tsx src/scripts/sync-exercise-dataset.ts",
    "sync:external-media": "tsx src/scripts/sync-external-exercise-media.ts",
    "seed:foods": "tsx src/scripts/seed-vietnamese-foods.ts",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@prisma/client": "6.19.3",
    "@supabase/supabase-js": "2.116.0",
    "@types/web-push": "^3.6.4",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "4.22.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "openai": "^6.45.0",
    "web-push": "^3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "prisma": "6.19.3",
    "supertest": "^7.2.2",
    "tsx": "4.23.13",
    "typescript": "^5.7.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "express": {
      "qs": "6.16.0"
    }
  }
}
