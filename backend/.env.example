PORT=4000
FRONTEND_URL=http://localhost:3000
# debug | info | warn | error (default info)
# LOG_LEVEL=info
# Log Prisma queries slower than this many ms; 0 turns it off.
# PRISMA_SLOW_QUERY_MS=0

# Database + Supabase: either Supabase Cloud or the self-hosted stack on the VPS
# (docs/supabase-switch.md). All five values must come from the same side, and
# the frontend's NEXT_PUBLIC_SUPABASE_* must point there too.
#   Cloud:       pooler URLs from Dashboard → Connect; keys from Project Settings → API Keys
#   Self-hosted: postgresql://postgres:<POSTGRES_PASSWORD>@supabase-db:5432/postgres,
#                https://supabase.hominhduc.cloud, ANON_KEY / SERVICE_ROLE_KEY
#                (all from ~/supabase/.env on the VPS)
# In production these five live in supabase.env, swapped by switch-backend.sh.
DATABASE_URL=postgresql://...
DIRECT_URL=postgresql://...

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-only: bypasses RLS. Never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required: Cloudinary delivery cloud for exercise media CDN URLs.
CLOUDINARY_CLOUD_NAME=
# Required when admin-uploaded exercise media should go directly to Cloudinary.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push / iOS Home Screen notifications.
# Generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@yeahbuddy.fit
# Scheduled reminders (unfinished workout, weight log, morning check-in) are
# polled in-process. Reminders are deduped in the database, so running the
# scheduler on several instances is safe. Set to false to turn it off.
NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_SCHEDULER_INTERVAL_MS=60000

# Optional: n8n production webhook URL for exporting workout logs.
N8N_LOGS_WEBHOOK_URL=

# AI Provider — choose "anthropic" or "openai"
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Generic key for the OpenAI-compatible provider, used when OPENAI_API_KEY is empty.
# AI_API_KEY=
# OpenAI reasoning models only: none | minimal | low | medium | high | xhigh.
# AI_REASONING_EFFORT=
# Per-request timeout in ms (default 60000).
# AI_REQUEST_TIMEOUT_MS=60000

# Custom AI base URL — for OpenAI-compatible APIs (Google AI Studio, Together, Groq, etc.)
# Examples:
#   Google AI Studio:  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   Together AI:        AI_BASE_URL=https://api.together.xyz/v1
#   Groq:               AI_BASE_URL=https://api.groq.com/openai/v1
# AI_BASE_URL=

# Set to "false" for models that reject response_format (e.g. Gemma via Google AI Studio).
# Gemini models support JSON mode; Gemma models do NOT — set AI_JSON_MODE=false for Gemma.
# AI_JSON_MODE=true

# ── Google Sheets program import (per-coach OAuth) ─────────────────────────
# Create an OAuth 2.0 Client ID of type "Web application" in Google Cloud Console
# (APIs & Services → Credentials) and enable the Google Sheets API + Drive API.
# Leave GOOGLE_OAUTH_CLIENT_ID empty to hide the Sheets tab in the import dialog.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match an Authorised redirect URI registered on that client, exactly.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/backend/api/coach/google/callback
# 32 random bytes, base64. Encrypts refresh tokens at rest — without it the
# connect flow refuses to store anything. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Only for the local script `npm --prefix backend run import:usda-nutrients`
# (USDA FoodData Central). Free key: https://api.data.gov/signup
# FDC_API_KEY=
