generator client {
  provider = "prisma-client-js"
  // Unlocks `relationLoadStrategy: "join"`, which loads a nested include in one
  // query instead of one per relation level. Opt-in per query; the default
  // strategy is unchanged everywhere else.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  trainee
  coach
  admin
}

/// Self-registered coaches wait for an admin decision before they can sign in.
enum CoachApprovalStatus {
  pending
  approved
  rejected
}

enum ProgramDifficulty {
  beginner
  intermediate
  advanced
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

enum MealStatus {
  planned
  consumed
}

enum WorkoutKind {
  push
  pull
  legs
  full_body
  cardio
  other
}

enum SetIntensityTag {
  mrm
  drop_set
  rest_pause
  cluster
  failure
  warmup
}

enum CoachRequestStatus {
  pending
  approved
  rejected
}

enum ExerciseImportRequestStatus {
  pending
  approved
  rejected
}

enum ExerciseActivityType {
  strength
  cardio
  mobility
  sport
  other
}

enum MuscleTargetRole {
  primary
  secondary
}

enum MuscleProfileStatus {
  pending
  approved
}

enum MuscleProfileSource {
  ai
  manual
}

enum WeightUnit {
  kg
  lbs
}

enum FoodSource {
  system
  user
}

enum FoodReviewStatus {
  pending
  approved
  rejected
}

enum FoodCategory {
  staple
  protein
  veg
  fruit
  dish
  drink
  other
}

enum FoodPriceTier {
  low
  medium
  high
}

enum DietType {
  vegetarian
  pescatarian
}

enum AIGenerationType {
  workout_program
  meal_plan
}

enum AIGenerationStatus {
  pending
  completed
  failed
  accepted
  discarded
}

enum NotificationType {
  workout_reminder
  meal_reminder
  check_in_reminder
  program_assigned
  coach_request
  workout_logged
  program_updated
  workout_session_open
  weight_reminder
  coach_weekly_review
  general
}

enum NotificationChannel {
  in_app
  email
  push
}

enum NotificationStatus {
  pending
  sent
  failed
  cancelled
}

enum PushDeliveryStatus {
  pending
  processing
  retrying
  sent
  failed
}

enum UserSex {
  male
  female
}

enum ActivityLevel {
  sedentary
  light
  moderate
  active
  very_active
}

enum VolumeProfileSource {
  system
  coach
  learned
}

enum VolumeRecommendationAction {
  increase
  maintain
  decrease
  deload
}

enum VolumeRecommendationStatus {
  pending
  accepted
  dismissed
  applied
}

model User {
  id                     String                    @id @default(uuid()) @db.Uuid
  supabaseAuthUserId     String?                   @unique @db.Uuid
  name                   String
  email                  String                    @unique
  username               String?                   @unique
  phone                  String?                   @unique
  role                   UserRole
  isActive               Boolean                   @default(true)
  /// Coach accounts only. A signup from /coach-signup lands here as `pending`
  /// with isActive false; an admin decision flips both together.
  coachApprovalStatus    CoachApprovalStatus?
  coachApprovalDecidedAt DateTime?
  avatar                 String?
  fitnessGoals           String[]                  @default([])
  preferredWeightUnit    WeightUnit                @default(kg)
  dailyCalorieGoal       Int                       @default(2500)
  dailyProteinGoal       Int                       @default(140)
  dailyCarbsGoal         Int                       @default(280)
  dailyFatGoal           Int                       @default(70)
  /// Keywords removed from AI meal-plan catalogs, e.g. "tôm", "đậu phộng".
  foodAllergies          String[]                  @default([])
  dietType               DietType?
  heightCm               Float?
  targetWeightKg         Float?
  goalStartWeightKg      Float?
  birthDate              DateTime?                 @db.Date
  sex                    UserSex?
  activityLevel          ActivityLevel?
  coachId                String?                   @db.Uuid
  coach                  User?                     @relation("CoachTrainees", fields: [coachId], references: [id], onDelete: SetNull)
  trainees               User[]                    @relation("CoachTrainees")
  meals                  Meal[]
  exercisesCreated       Exercise[]                @relation("ExerciseCreator")
  exerciseImportRequests ExerciseImportRequest[]   @relation("ExerciseImportSubmitter")
  exerciseImportReviews  ExerciseImportRequest[]   @relation("ExerciseImportReviewer")
  muscleProfilesReviewed Variation[]               @relation("MuscleProfileReviewer")
  foodsCreated           Food[]                    @relation("FoodCreator")
  foodsReviewed          Food[]                    @relation("FoodReviewer")
  googleConnection       GoogleConnection?
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  notificationPreference NotificationPreference?
  programsCreated        Program[]                 @relation("ProgramCreator")
  programAssignments     ProgramAssignment[]
  workoutLogs            WorkoutLog[]
  workoutLogComments     WorkoutLogComment[]       @relation("WorkoutLogCommentAuthor")
  workoutSessionDrafts   WorkoutSessionDraft[]
  bodyMetricsAsTrainee   BodyMetricEntry[]         @relation("BodyMetricTrainee")
  bodyMetricsAsCoach     BodyMetricEntry[]         @relation("BodyMetricCoach")
  checkInsAsTrainee      CoachCheckIn[]            @relation("CoachCheckInTrainee")
  checkInsAsCoach        CoachCheckIn[]            @relation("CoachCheckInCoach")
  coachRequestsAsCoach   CoachRequest[]            @relation("CoachRequestCoach")
  coachRequestsAsTrainee CoachRequest[]            @relation("CoachRequestTrainee")
  adminAuditLogs         AdminAuditLog[]           @relation("AdminAuditActor")
  aiGenerations          AIGeneration[]
  recoveryCheckIns       RecoveryCheckIn[]
  muscleVolumeProfiles   UserMuscleVolumeProfile[]
  volumeRecommendations  VolumeRecommendation[]
  exerciseOverrides      TraineeExerciseOverride[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@index([coachId])
  @@index([username])
  @@index([phone])
  @@index([role, coachApprovalStatus])
}

model Exercise {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  muscleGroup String
  createdById String?     @db.Uuid
  createdBy   User?       @relation("ExerciseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  variations  Variation[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([createdById])
}

model Variation {
  id                        String                  @id @default(uuid()) @db.Uuid
  exerciseId                String                  @db.Uuid
  name                      String
  equipment                 String?
  isDefault                 Boolean                 @default(false)
  sortOrder                 Int                     @default(0)
  metadata                  Json?
  source                    String?
  sourceId                  String?
  activityType              ExerciseActivityType?
  muscleProfileStatus       MuscleProfileStatus     @default(pending)
  muscleProfileSource       MuscleProfileSource?
  muscleProfileRationale    String?
  muscleProfileReviewedAt   DateTime?
  muscleProfileReviewedById String?                 @db.Uuid
  exercise                  Exercise                @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleProfileReviewedBy   User?                   @relation("MuscleProfileReviewer", fields: [muscleProfileReviewedById], references: [id], onDelete: SetNull)
  muscleTargets             VariationMuscleTarget[]
  workoutExercises          WorkoutExercise[]
  traineeOverrides          TraineeExerciseOverride[] @relation("TraineeOverrideVariation")
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  @@unique([exerciseId, name])
  @@unique([source, sourceId])
  @@index([equipment])
  @@index([exerciseId, sortOrder])
  @@index([activityType, muscleProfileStatus])
  @@index([muscleProfileReviewedById])
}

model MuscleRegion {
  slug                  String                    @id
  targets               VariationMuscleTarget[]
  recoveryRatings       MuscleRecoveryRating[]
  userVolumeProfiles    UserMuscleVolumeProfile[]
  volumeRecommendations VolumeRecommendation[]
  createdAt             DateTime                  @default(now())
}

model RecoveryCheckIn {
  id               String                 @id @default(uuid()) @db.Uuid
  userId           String                 @db.Uuid
  checkInDate      DateTime               @db.Date
  sleepMinutes     Int?
  sleepQuality     Int?
  fatigue          Int
  stress           Int?
  readinessScore   Float?
  algorithmVersion String?
  note             String?
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  muscles          MuscleRecoveryRating[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([userId, checkInDate])
}

model MuscleRecoveryRating {
  checkInId  String          @db.Uuid
  muscleSlug String
  soreness   Int
  pain       Int?
  checkIn    RecoveryCheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  muscle     MuscleRegion    @relation(fields: [muscleSlug], references: [slug], onDelete: Restrict)

  @@id([checkInId, muscleSlug])
  @@index([muscleSlug])
}

model UserMuscleVolumeProfile {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @db.Uuid
  muscleSlug    String
  mevSets       Float?
  mavMinSets    Float?
  mavMaxSets    Float?
  mrvSets       Float?
  confidence    Float               @default(0)
  source        VolumeProfileSource @default(system)
  weeksObserved Int                 @default(0)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  muscle        MuscleRegion        @relation(fields: [muscleSlug], references: [slug], onDelete: Restrict)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([userId, muscleSlug])
  @@index([muscleSlug])
}

model VolumeRecommendation {
  id               String                     @id @default(uuid()) @db.Uuid
  userId           String                     @db.Uuid
  muscleSlug       String?
  weekStart        DateTime                   @db.Date
  action           VolumeRecommendationAction
  status           VolumeRecommendationStatus @default(pending)
  currentSets      Float
  recommendedSets  Float
  confidence       Float
  reasons          Json
  algorithmVersion String
  acceptedAt       DateTime?
  dismissedAt      DateTime?
  appliedAt        DateTime?
  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  muscle           MuscleRegion?              @relation(fields: [muscleSlug], references: [slug], onDelete: Restrict)
  createdAt        DateTime                   @default(now())

  @@index([userId, weekStart])
  @@index([muscleSlug])
}

model VariationMuscleTarget {
  variationId String           @db.Uuid
  muscleSlug  String
  role        MuscleTargetRole
  position    Int              @default(0)
  variation   Variation        @relation(fields: [variationId], references: [id], onDelete: Cascade)
  muscle      MuscleRegion     @relation(fields: [muscleSlug], references: [slug], onDelete: Restrict)
  createdAt   DateTime         @default(now())

  @@id([variationId, muscleSlug])
  @@index([muscleSlug, role])
  @@index([variationId, role, position])
}

model ExerciseImportRequest {
  id            String                      @id @default(uuid()) @db.Uuid
  submittedById String                      @db.Uuid
  reviewedById  String?                     @db.Uuid
  status        ExerciseImportRequestStatus @default(pending)
  fileName      String?
  rowCount      Int
  rows          Json
  reviewNote    String?
  result        Json?
  submittedBy   User                        @relation("ExerciseImportSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedBy    User?                       @relation("ExerciseImportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  @@index([status, createdAt])
  @@index([submittedById])
  @@index([reviewedById])
}

model Food {
  id            String         @id @default(uuid()) @db.Uuid
  slug          String         @unique
  name          String
  category      FoodCategory
  brand         String?
  barcode       String?        @unique
  servingAmount Float          @default(1)
  servingUnit   String         @default("serving")
  servingLabel  String
  /// What one serving weighs. Prepared dishes are sold by the bowl or plate, so
  /// without this there is no way to show or enter them in grams. Null means the
  /// weight is unknown and the food keeps its own serving label.
  servingGrams  Float?
  calories      Float
  protein       Float?
  carbs         Float?
  fat           Float?
  fiber         Float?
  sugar         Float?
  sodium        Float?
  /// Optional; AI meal plans only filter on these when they are set.
  priceTier     FoodPriceTier?
  prepMinutes   Int?
  source        FoodSource       @default(system)
  isVerified    Boolean          @default(false)
  reviewStatus  FoodReviewStatus @default(pending)
  reviewedAt    DateTime?
  reviewNote    String?
  createdById   String?        @db.Uuid
  createdBy     User?          @relation("FoodCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedById  String?        @db.Uuid
  reviewedBy    User?          @relation("FoodReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  mealItems     MealFoodItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([createdById])
  @@index([reviewStatus, createdAt])
  @@index([reviewedById])
  @@index([category])
  @@index([name])
}

model Program {
  id                  String              @id @default(uuid()) @db.Uuid
  name                String
  description         String?
  duration            Int
  /// Day the program's week 1 begins. Null keeps the old behaviour, where the
  /// anchor is the week each trainee was assigned.
  startDate           DateTime?           @db.Date
  difficulty          ProgramDifficulty
  workoutsPerWeek     Int
  isAIGenerated       Boolean             @default(false)
  /// Non-null when this program is a trainee-personalized copy forked from a
  /// coach-authored template, for example after the trainee swaps an exercise.
  ///
  /// Swaps no longer fork, so nothing sets this any more; it survives for the
  /// copies made before that changed. SetNull rather than Cascade: deleting the
  /// original must not take the copy with it, because the copy is the only
  /// place that trainee's plan and workout logs live. Losing the pointer just
  /// promotes the copy to a program in its own right.
  forkedFromProgramId String?             @db.Uuid
  forkedFromProgram   Program?            @relation("ProgramFork", fields: [forkedFromProgramId], references: [id], onDelete: SetNull)
  forks               Program[]           @relation("ProgramFork")
  googleSpreadsheetId String?
  googleSheetName     String?
  createdById         String              @db.Uuid
  createdBy           User                @relation("ProgramCreator", fields: [createdById], references: [id], onDelete: Cascade)
  workouts            Workout[]
  assignments         ProgramAssignment[]
  archivedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  /// Export writes results straight into the sheet's cells, so two programs
  /// sharing one spreadsheet would overwrite each other. Postgres treats NULLs
  /// as distinct, so programs with no sheet are unaffected. A coach reusing a
  /// sheet has to unlink it from the old program first.
  @@unique([googleSpreadsheetId])
  @@index([createdById, googleSpreadsheetId, googleSheetName])
  @@index([createdById])
  @@index([createdById, archivedAt])
  @@index([forkedFromProgramId])
}

/// One coach's Google account link, used to read program templates from their Sheets.
///
/// Tokens are stored encrypted (AES-256-GCM, key from GOOGLE_TOKEN_ENCRYPTION_KEY);
/// the columns hold ciphertext, never the raw token. One row per user: reconnecting
/// replaces the row rather than accumulating stale grants.
model GoogleConnection {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @db.Uuid
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Google account this grant belongs to, shown in the UI so a coach can tell
  /// which account is connected without another API round trip.
  googleEmail           String?
  accessTokenEncrypted  String
  /// Google only returns a refresh token on the first consent, so a missing value
  /// means the connection cannot outlive the current access token.
  refreshTokenEncrypted String?
  /// When the current access token stops working. Refreshed ahead of this.
  expiresAt             DateTime
  /// Space-separated scopes actually granted, which may be narrower than requested.
  scope                 String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([expiresAt])
}

model ProgramAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  programId  String   @db.Uuid
  userId     String   @db.Uuid
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  /// Spreadsheet in the trainee's own Google Drive that this program's logs are
  /// exported into. Null until the first export; reused afterwards.
  traineeGoogleSpreadsheetId String?

  @@unique([programId, userId])
  @@index([userId])
}

model Workout {
  id            String            @id @default(uuid()) @db.Uuid
  programId     String?           @db.Uuid
  name          String
  kind          WorkoutKind?
  weekIndex     Int?
  scheduledDay  Int?
  scheduledDate DateTime?         @db.Date
  duration      Int?
  notes         String?
  program       Program?          @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises     WorkoutExercise[]
  logs          WorkoutLog[]
  sessionDrafts WorkoutSessionDraft[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([programId])
  @@index([programId, weekIndex])
  @@index([scheduledDate])
}

model WorkoutExercise {
  id                  String        @id @default(uuid()) @db.Uuid
  workoutId           String        @db.Uuid
  variationId         String        @db.Uuid
  originalVariationId String?       @db.Uuid
  order               Int
  restTime            Int?
  notes               String?
  workout             Workout       @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  variation           Variation     @relation(fields: [variationId], references: [id], onDelete: Restrict)
  sets                ExerciseSet[]
  traineeOverrides    TraineeExerciseOverride[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([variationId])
  @@index([workoutId, order])
}

/// One trainee's substitute for a single exercise slot in a coach's program.
///
/// This is what lets a trainee swap an exercise mid-session without forking the
/// coach's program: the slot still belongs to the coach and every other trainee
/// on that program still sees the coach's choice, while this row is read back
/// only for this trainee. When the coach approves the swap, the change is
/// written into the coach's own WorkoutExercise and the row is dropped.
model TraineeExerciseOverride {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @db.Uuid
  workoutExerciseId String          @db.Uuid
  /// What the trainee does instead.
  variationId       String          @db.Uuid
  /// What the slot held when the trainee swapped. If the coach later moves the
  /// slot to something else, this no longer matches and the override is stale —
  /// the coach's newer choice wins.
  replacedVariationId String        @db.Uuid
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  variation         Variation       @relation("TraineeOverrideVariation", fields: [variationId], references: [id], onDelete: Restrict)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([userId, workoutExerciseId])
  @@index([userId])
  @@index([workoutExerciseId])
  @@index([variationId])
}

model ExerciseSet {
  id                String           @id @default(uuid()) @db.Uuid
  workoutExerciseId String           @db.Uuid
  setNumber         Int
  targetRepsMin     Int?
  targetReps        Int
  actualReps        Int?
  weight            Float?
  rir               Int?
  intensityTag      SetIntensityTag?
  notes             String?
  completed         Boolean          @default(false)
  workoutExercise   WorkoutExercise  @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutExerciseId, setNumber])
}

model WorkoutSessionDraft {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @db.Uuid
  workoutId            String   @db.Uuid
  workoutName          String?
  startedAt            DateTime
  currentExerciseIndex Int      @default(0)
  exercises            Json
  deletedSetIds        String[] @default([])
  schemaVersion        Int?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout              Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, workoutId])
  @@index([userId, updatedAt])
  @@index([workoutId])
  @@index([startedAt])
}

model WorkoutLog {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @db.Uuid
  workoutId        String?             @db.Uuid
  programId        String?             @db.Uuid
  workoutSnapshot  Json?
  exerciseSnapshot Json?
  plannedDate      DateTime?           @db.Date
  startedAt        DateTime
  completedAt      DateTime?
  totalVolume      Float?
  notes            String?
  /// Client-generated idempotency key: an offline log replayed after a lost
  /// response resolves to the row already written instead of a duplicate.
  clientLogId      String?             @db.Uuid
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout          Workout?            @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  comments         WorkoutLogComment[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([userId, clientLogId])
  @@index([userId, startedAt])
  @@index([userId, plannedDate])
  @@index([workoutId])
  @@index([programId])
}

model WorkoutLogComment {
  id           String     @id @default(uuid()) @db.Uuid
  workoutLogId String     @db.Uuid
  authorId     String     @db.Uuid
  content      String
  workoutLog   WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  author       User       @relation("WorkoutLogCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([workoutLogId, createdAt])
  @@index([authorId, createdAt])
}

model BodyMetricEntry {
  id         String   @id @default(uuid()) @db.Uuid
  traineeId  String   @db.Uuid
  coachId    String?  @db.Uuid
  recordedAt DateTime @default(now())
  weightKg   Float?
  bodyFatPct Float?
  chestCm    Float?
  waistCm    Float?
  hipsCm     Float?
  armCm      Float?
  thighCm    Float?
  note       String?
  trainee    User     @relation("BodyMetricTrainee", fields: [traineeId], references: [id], onDelete: Cascade)
  coach      User?    @relation("BodyMetricCoach", fields: [coachId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([traineeId, recordedAt])
  @@index([coachId])
}

model CoachCheckIn {
  id             String   @id @default(uuid()) @db.Uuid
  traineeId      String   @db.Uuid
  coachId        String   @db.Uuid
  checkInDate    DateTime @default(now())
  adherenceScore Int?
  energyScore    Int?
  recoveryScore  Int?
  moodScore      Int?
  summary        String?
  feedback       String
  nextFocus      String?
  trainee        User     @relation("CoachCheckInTrainee", fields: [traineeId], references: [id], onDelete: Cascade)
  coach          User     @relation("CoachCheckInCoach", fields: [coachId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([traineeId, checkInDate])
  @@index([coachId, createdAt])
}

model Meal {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  type       MealType
  status     MealStatus     @default(consumed)
  name       String
  loggedDate DateTime       @db.Date
  calories   Float
  protein    Float?
  carbs      Float?
  fat        Float?
  fiber      Float?
  sugar      Float?
  sodium     Float?
  recordedAt DateTime
  /// Set when a coach reviews a planned meal; null for self-logged meals.
  coachNote       String?
  coachReviewedAt DateTime?
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      MealFoodItem[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([userId, loggedDate, type, status])
  @@index([userId, loggedDate])
  @@index([userId, recordedAt])
}

model MealFoodItem {
  id               String   @id @default(uuid()) @db.Uuid
  mealId           String   @db.Uuid
  foodId           String   @db.Uuid
  quantity         Float    @default(1)
  amountValue      Float    @default(1)
  amountUnit       String   @default("serving")
  amountLabel      String?
  weightGrams      Float?
  notes            String?
  foodNameSnapshot String?
  calories         Float    @default(0)
  protein          Float?
  carbs            Float?
  fat              Float?
  fiber            Float?
  sugar            Float?
  sodium           Float?
  meal             Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food             Food     @relation(fields: [foodId], references: [id], onDelete: Restrict)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([foodId])
  @@index([mealId])
}

model CoachRequest {
  id        String             @id @default(uuid()) @db.Uuid
  traineeId String             @db.Uuid
  coachId   String             @db.Uuid
  status    CoachRequestStatus @default(pending)
  trainee   User               @relation("CoachRequestTrainee", fields: [traineeId], references: [id], onDelete: Cascade)
  coach     User               @relation("CoachRequestCoach", fields: [coachId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([traineeId, coachId])
  @@index([coachId, status])
}

model Notification {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @db.Uuid
  type              NotificationType
  channel           NotificationChannel @default(in_app)
  status            NotificationStatus  @default(pending)
  title             String
  message           String
  scheduledFor      DateTime            @default(now())
  sentAt            DateTime?
  readAt            DateTime?
  relatedEntityType String?
  relatedEntityId   String?
  metadata          Json?
  /// Deterministic key for scheduled reminders (e.g. `weight_reminder:<userId>:2026-09-20`).
  /// Unique, so a reminder is stored and pushed at most once even when several
  /// scheduler ticks or backend instances race. Null for event notifications.
  dedupeKey         String?             @unique
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushDeliveries    PushDelivery[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([userId, status, scheduledFor])
  @@index([userId, createdAt])
  @@index([relatedEntityType, relatedEntityId])
  @@index([readAt])
}

/// Per-user notification settings. A user without a row gets the column defaults:
/// event notifications on, scheduled reminders off until they opt in.
model NotificationPreference {
  id                      String   @id @default(uuid()) @db.Uuid
  userId                  String   @unique @db.Uuid
  /// IANA zone reminder times are read in, captured from the browser on save.
  timeZone                String   @default("Asia/Ho_Chi_Minh")
  /// Push for "coach assigned a program" and "coach updated your program".
  coachProgramUpdates     Boolean  @default(true)
  /// Push when a started workout session is left unfinished.
  workoutSessionReminders Boolean  @default(true)
  weightReminderEnabled   Boolean  @default(false)
  /// Local wall-clock time, `HH:mm`.
  weightReminderTime      String   @default("07:00")
  /// Days of week in the user's zone, 0 = Sunday … 6 = Saturday.
  weightReminderDays      Int[]    @default([0, 1, 2, 3, 4, 5, 6])
  dailyCheckInEnabled     Boolean  @default(false)
  /// Local wall-clock time, `HH:mm`.
  dailyCheckInTime        String   @default("07:00")
  /// Meal reminders fire at the local `HH:mm` only while that meal has no logged calories today.
  breakfastReminderEnabled Boolean @default(false)
  breakfastReminderTime   String   @default("07:30")
  lunchReminderEnabled    Boolean  @default(false)
  lunchReminderTime       String   @default("12:00")
  dinnerReminderEnabled   Boolean  @default(false)
  dinnerReminderTime      String   @default("18:30")
  snackReminderEnabled    Boolean  @default(false)
  snackReminderTime       String   @default("15:30")
  /// Sent `workoutReminderOffsetMinutes` (15/30/60) before the usual training time,
  /// on days the user's schedule has a workout.
  workoutReminderEnabled  Boolean  @default(false)
  workoutReminderTime     String   @default("18:00")
  workoutReminderOffsetMinutes Int @default(30)
  /// Coaches only: end-of-week nudge to review trainees. Day is 0 = Sunday … 6 = Saturday.
  coachWeeklyReviewEnabled Boolean @default(true)
  coachWeeklyReviewDay    Int      @default(0)
  coachWeeklyReviewTime   String   @default("18:00")
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([weightReminderEnabled])
  @@index([dailyCheckInEnabled])
  @@index([workoutReminderEnabled])
}

model PushSubscription {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  endpoint  String    @unique
  p256dh    String
  auth      String
  /// Locale captured from this device, so OS-level push copy matches the app language.
  locale    String    @default("en")
  userAgent String?
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, revokedAt])
}

model PushDelivery {
  id             String             @id @default(uuid()) @db.Uuid
  notificationId String             @db.Uuid
  subscriptionId String             @db.Uuid
  status         PushDeliveryStatus @default(pending)
  attemptCount   Int                @default(0)
  nextAttemptAt  DateTime           @default(now())
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  lastError      String?
  notification   Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  subscription   PushSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([notificationId, subscriptionId])
  @@index([status, nextAttemptAt])
  @@index([subscriptionId, status])
}

model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  adminId     String   @db.Uuid
  action      String
  entityType  String
  entityId    String?  @db.Uuid
  entityLabel String?
  metadata    Json?
  admin       User     @relation("AdminAuditActor", fields: [adminId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([entityType, createdAt])
}

model AIGeneration {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @db.Uuid
  type       AIGenerationType
  status     AIGenerationStatus @default(pending)
  input      Json
  output     Json?
  programId  String?            @db.Uuid
  tokenUsage Int?
  errorMsg   String?
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())

  @@index([userId, type, createdAt])
}
